PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_ANON_KEY=your-anon-key
# Required for Settings → Users (create/list accounts). Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Production frontend origin (no trailing slash)
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated extra origins (e.g. staging URL)
# ALLOWED_ORIGINS=https://staging.example.com
# Optional: allow all *.vercel.app preview deployments
# ALLOW_VERCEL_PREVIEWS=true
# Optional: enable POST /api/setup/migrate* in production (prefer Supabase SQL Editor instead)
# ALLOW_SETUP_MIGRATIONS=false
# Optional: needed only for automated setup migrations
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

PORT=3000
# Server-side only: Express API URL used by Next.js rewrites
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Leave empty in production so the browser uses same-origin /api (rewritten to BACKEND_URL).
# For local direct-to-API debugging you can set http://localhost:4000
NEXT_PUBLIC_API_URL=
